# Sao chep thanh .env. Dien gia tri rieng cua moi truong; khong commit secret.
# Prisma/PostgreSQL: lay chuoi ket noi tu nha cung cap hoac may chu cua ban.
DATABASE_URL=

# Doi thanh URL HTTPS that khi trien khai.
BETTER_AUTH_URL=http://localhost:3000
# Tao khoa rieng: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# API tuong thich Ollama; base URL can co duoi /api.
OLLAMA_BASE_URL=https://ollama.com/api
# Chi can khi endpoint yeu cau xac thuc; khong dat khoa vao NEXT_PUBLIC_*.
OLLAMA_API_KEY=
# Dien ten model duoc endpoint ho tro. De trong se dung mac dinh trong provider.ts.
# Lua chon model o giao dien gia su co the ghi de gia tri nay.
OLLAMA_MODEL=
